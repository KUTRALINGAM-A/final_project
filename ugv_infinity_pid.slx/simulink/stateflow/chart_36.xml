      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [x_des, y_des, theta_des, v_ff, w_ff] = fcn(t)
A = 2.0; B = 1.0; w = 0.25;
wt = w * t;
x_des = A * sin(wt);
y_des = B * sin(2.0 * wt);
x_dot = A * w * cos(wt);
y_dot = 2.0 * B * w * cos(2.0 * wt);
x_ddot = -A * (w^2) * sin(wt);
y_ddot = -4.0 * B * (w^2) * sin(2.0 * wt);
speed_sq = x_dot^2 + y_dot^2;
v_ff = sqrt(speed_sq);
w_ff = (x_dot * y_ddot - y_dot * x_ddot) / max(speed_sq, 1e-6);
theta_des = atan2(y_dot, x_dot);
</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
      </eml>
    </state>
