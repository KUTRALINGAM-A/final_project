      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [v_cmd, yaw_rate_cmd, e_long, e_lat, e_th] = fcn(x_des, y_des, theta_des, v_ff, w_ff, x_act, y_act, th_act)
dt = 0.032;
persistent int_long prev_e_long has_long
persistent int_th prev_e_th has_th
persistent int_lat prev_e_lat has_lat
if isempty(int_long)
    int_long = 0.0; prev_e_long = 0.0; has_long = false;
    int_th = 0.0; prev_e_th = 0.0; has_th = false;
    int_lat = 0.0; prev_e_lat = 0.0; has_lat = false;
end
dx = x_des - x_act; dy = y_des - y_act;
e_long =  cos(theta_des) * dx + sin(theta_des) * dy;
e_lat  = -sin(theta_des) * dx + cos(theta_des) * dy;
e_th   = atan2(sin(theta_des - th_act), cos(theta_des - th_act));
% Longitudinal PID
int_long = max(-0.5, min(0.5, int_long + e_long * dt));
d_long = 0.0;
if has_long, d_long = (e_long - prev_e_long) / dt; else, has_long = true; end
prev_e_long = e_long;
dv = max(-1.0, min(1.0, 1.2 * e_long + 0.05 * int_long + 0.10 * d_long));
v_cmd = max(0.05, v_ff + dv);
% Heading PID
int_th = max(-0.5, min(0.5, int_th + e_th * dt));
d_th = 0.0;
if has_th, d_th = atan2(sin(e_th - prev_e_th), cos(e_th - prev_e_th)) / dt; else, has_th = true; end
prev_e_th = e_th;
dw_th = max(-4.0, min(4.0, 2.8 * e_th + 0.08 * int_th + 0.25 * d_th));
% Lateral PID
int_lat = max(-0.5, min(0.5, int_lat + e_lat * dt));
d_lat = 0.0;
if has_lat, d_lat = (e_lat - prev_e_lat) / dt; else, has_lat = true; end
prev_e_lat = e_lat;
dw_lat = max(-3.0, min(3.0, 1.5 * e_lat + 0.05 * int_lat + 0.15 * d_lat));
yaw_rate_cmd = w_ff + dw_th + dw_lat;
</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
      </eml>
