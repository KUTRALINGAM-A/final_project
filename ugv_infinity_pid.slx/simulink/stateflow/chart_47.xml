      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [x_act, y_act, th_act, wL, wR] = fcn(v_cmd, yaw_rate_cmd)
dt = 0.032; R = 0.05; W = 0.27; alpha = 0.25;
persistent x y th filt_wL filt_wR
if isempty(x)
    x = 0.0;
    y = 0.0;
    th = pi / 4.0;
    filt_wL = 0.0;
    filt_wR = 0.0;
end
% 1. Wheel speed commands from inverse kinematics
wL_cmd = (v_cmd - 0.5 * W * yaw_rate_cmd) / R;
wR_cmd = (v_cmd + 0.5 * W * yaw_rate_cmd) / R;
% 2. Wheel speed filtering and motor saturation limits (+-20 rad/s)
target_wL = max(-20.0, min(20.0, wL_cmd));
target_wR = max(-20.0, min(20.0, wR_cmd));
filt_wL = filt_wL + alpha * (target_wL - filt_wL);
filt_wR = filt_wR + alpha * (target_wR - filt_wR);
% 3. Forward kinematics
v = R * (filt_wL + filt_wR) / 2.0;
omega = R * (filt_wR - filt_wL) / W;
% 4. Pose integration
x = x + dt * v * cos(th);
y = y + dt * v * sin(th);
th = atan2(sin(th + dt * omega), cos(th + dt * omega));
% 5. Unconditional output assignments (strictly scalar double)
x_act  = double(x);
y_act  = double(y);
th_act = double(th);
wL     = double(filt_wL);
wR     = double(filt_wR);
</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
      </eml>
